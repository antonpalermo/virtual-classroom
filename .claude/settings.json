{
    "enabledPlugins": {
        "superpowers@claude-plugins-official": true
    },
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "permissions": {
        "deny": [
            "Read(./**/worker-configuration.d.ts)",
            "Read(./package-lock.json)",
            "Read(./packages/web-standards/src/status-codes.ts)",
            "Read(./packages/web-standards/src/status-phrases.ts)"
        ],
        "ask": [
            "Bash(rm -rf:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push --force-with-lease:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean -f:*)",
            "Bash(git clean -fd:*)",
            "Bash(git branch -D:*)",
            "Bash(git checkout --:*)",
            "Bash(git restore:*)",
            "Bash(wrangler deploy:*)",
            "Bash(npm run deploy:*)",
            "Bash(npm uninstall:*)",
            "Bash(npm remove:*)",
            "Bash(npm rm:*)"
        ],
        "allow": [
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(ls:*)",
            "Bash(find:*)",
            "Bash(wc:*)",
            "Bash(cat:*)",
            "Bash(turbo run build:*)",
            "Bash(turbo run dev:*)",
            "Bash(turbo run lint:*)",
            "Bash(turbo run check-types:*)",
            "Bash(turbo run typegen:*)",
            "Bash(npm run build:*)",
            "Bash(npm run dev:*)",
            "Bash(npm run lint:*)",
            "Bash(npm run check-types:*)",
            "Bash(npm run typegen:*)"
        ]
    }
}
