{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "worker-auth",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-22",
    "compatibility_flags": ["nodejs_compat"],
    "d1_databases": [
        {
            "binding": "AUTH_DB",
            "database_name": "worker-auth",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "drizzle"
        }
    ],
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "dev": {
        // Default port 8787 collides with worker-realtime's wrangler dev; default inspector_port
        // 9229 collides with worker-client's Vite plugin inspector. Unlike Vite, wrangler dev
        // doesn't fall back automatically and crashes fatally on collision.
        "port": 8789,
        "inspector_port": 9230
    }
}
