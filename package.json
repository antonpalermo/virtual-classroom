{
    "name": "@capstone/source",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typegen": "turbo run typegen",
        "format": "biome format --write",
        "check-types": "turbo run check-types",
        "prepare": "husky"
    },
    "lint-staged": {
        "*": ["biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"]
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.7.4",
        "turbo": "^2.10.8",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=18"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": "11.16.0"
        }
    },
    "workspaces": ["apps/*", "packages/*"],
    "allowScripts": {
        "esbuild@0.28.1": true,
        "workerd@1.20260811.1": true
    }
}
